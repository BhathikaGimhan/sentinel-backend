# Required — local development only (never commit .env)
GEMINI_API_KEY=

# News cron sync (local dev). Production: GitHub secret → GCP Secret Manager → Cloud Run
# https://www.cryptocompare.com/cryptopian/api-keys
CRYPTOCOMPARE_API_KEY=

# Optional — trade execution only
BINANCE_API_KEY=
BINANCE_API_SECRET=

PORT=8787
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Firebase Admin (local dev)
# FIREBASE_CREDENTIALS_PATH=./forex-market-ai-firebase.json
# Cloud Run production: FIREBASE_USE_ADC=true

# Candle sync
CRON_SECRET=generate-with-openssl-rand-hex-32
CANDLE_SYNC_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
CANDLE_SYNC_ON_STARTUP=true
NEWS_SYNC_ON_STARTUP=true

# Google sign-in admins (comma-separated emails or local parts)
ADMIN_EMAILS=bgmaduragoda@gmail.com
ADMIN_LOCAL_PARTS=bgmaduragoda

# ── Production secrets (GitHub Actions → sentinel-backend-relay repo) ──────────
# Settings → Secrets and variables → Actions → New repository secret:
#   CRYPTOCOMPARE_API_KEY   ← your CryptoCompare key
#   GEMINI_API_KEY
#   CRON_SECRET
#   BINANCE_API_KEY         (optional)
#   BINANCE_API_SECRET      (optional)
#
# On deploy, workflow syncs these to GCP Secret Manager and mounts them on Cloud Run.
# You do NOT put API keys in the frontend repo or in Cloud Run plain env vars.
