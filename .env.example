# Required
GEMINI_API_KEY=

# Optional — trade execution only
BINANCE_API_KEY=
BINANCE_API_SECRET=

PORT=8787
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Firebase Admin (local dev)
# FIREBASE_CREDENTIALS_PATH=./forex-market-ai-firebase.json
# Cloud Run production: FIREBASE_USE_ADC=true

# Candle sync
CRON_SECRET=generate-with-openssl-rand-hex-32
CANDLE_SYNC_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
CANDLE_SYNC_ON_STARTUP=true
